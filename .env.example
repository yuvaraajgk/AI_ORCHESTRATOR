# Cloudflare Workers AI — see PROJECT_SUMMARY.md §9 for provider history/context.
# CLOUDFLARE_MODEL must be a currently non-deprecated model ID — check
# https://developers.cloudflare.com/workers-ai/models/ before assuming this
# value still works, this project has been broken by silent model deprecation
# on the provider side twice already.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# Local dev defaults — match the docker containers documented in
# PROJECT_SUMMARY.md §11 / DEVLOG.md Day 9-10. Change host/port/credentials
# for any other environment.
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://aiorc:aiorc123@localhost:5432/aiorc_db
RAG_DATABASE_URL=postgresql://aiorc:aiorc123@localhost:5433/aiorc_rag_db
